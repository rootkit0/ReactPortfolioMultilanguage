---
import type { Lang } from '@/i18n';
import { t, hreflangLinks } from '@/i18n';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  jsonLd?: object;
}

const {
  lang,
  title,
  description,
  canonical = 'https://www.xavierberga.com/',
  ogTitle,
  ogDescription,
  ogImage = 'https://www.xavierberga.com/og-image.png',
  jsonLd,
} = Astro.props;

const hreflangs = hreflangLinks(new URL(Astro.request.url).pathname);
const langMap: Record<string, string> = { es: 'es-ES', ca: 'ca', en: 'en' };
const htmlLang = langMap[lang] ?? 'es-ES';
const ogLocale = lang === 'ca' ? 'ca' : lang === 'en' ? 'en_US' : 'es_ES';
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

  <!-- Indexación -->
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="format-detection" content="telephone=yes" />
  <meta name="theme-color" content="#0b1220" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

  <!-- Canonical -->
  <link rel="canonical" href={canonical} />

  <!-- Hreflang -->
  {hreflangs.map((h) => (
    <link rel="alternate" hreflang={h.lang} href={h.href} />
  ))}

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href="https://www.xavierberga.com/sitemap.xml" />

  <!-- Icons -->
  <link rel="icon" href="/logo.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

  <!-- Title + Description -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Xavier Berga" />

  <!-- Open Graph -->
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Xavier Berga" />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content="Xavier Berga - Ingeniería IA e IoT" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={ogDescription ?? description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
</head>

<body>
  <Navbar lang={lang} />
  <div class="App" id="scroll">
    <slot />
    <Footer lang={lang} />
  </div>

  <!-- Language switcher script (client-side cookie) -->
  <script>
    document.addEventListener('click', (e) => {
      const flag = (e.target as HTMLElement).closest('[data-lang]');
      if (!flag) return;
      const lang = (flag as HTMLElement).dataset.lang;
      document.cookie = `lang=${lang};path=/;max-age=${60 * 60 * 24 * 365};SameSite=Lax`;
      window.location.reload();
    });
  </script>
</body>
</html>
