---
import type { Lang } from '@/i18n';
import { absoluteUrl, hreflangLinks } from '@/i18n';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  jsonLd?: object;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  canonical = absoluteUrl(new URL(Astro.request.url).pathname),
  ogTitle,
  ogDescription,
  ogImage = absoluteUrl('/og-image.svg'),
  jsonLd,
  noindex = false,
} = Astro.props;

const hreflangs = hreflangLinks(new URL(Astro.request.url).pathname);
const langMap: Record<string, string> = { es: 'es-ES', ca: 'ca', en: 'en' };
const htmlLang = langMap[lang] ?? 'es-ES';
const ogLocale = lang === 'ca' ? 'ca_ES' : lang === 'en' ? 'en_US' : 'es_ES';
const robots = noindex
  ? 'noindex,nofollow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
---
<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content={robots} />
  <meta name="googlebot" content={robots} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="format-detection" content="telephone=yes" />
  <meta name="theme-color" content="#0b1220" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

  <link rel="canonical" href={canonical} />
  {hreflangs.map((h) => (
    <link rel="alternate" hreflang={h.lang} href={h.href} />
  ))}
  <link rel="sitemap" type="application/xml" href="https://www.xavierberga.com/sitemap.xml" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/logo.ico" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Xavier Berga" />

  <meta property="og:locale" content={ogLocale} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Xavier Berga" />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content="Xavier Berga - AI and IoT engineering" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={ogDescription ?? description} />
  <meta name="twitter:image" content={ogImage} />

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
</head>

<body>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <Navbar lang={lang} />
  <div class="App" id="scroll">
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
  </div>
</body>
</html>
