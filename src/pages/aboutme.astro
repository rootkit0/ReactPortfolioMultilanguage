  { label: 'JavaScript', svg: '<svg viewBox="0 0 24 24"><path fill="#F7DF1E" d="M0 0h24v24H0V0zm22.034 18.276c-.175-1.095-.888-2.015-3.003-2.873-.736-.345-1.554-.585-1.797-1.14-.091-.33-.105-.51-.046-.705.15-.646.915-.84 1.515-.66.39.12.75.42.975.9 1.035-.675 1.035-.675 1.755-1.125-.27-.42-.405-.6-.585-.78-.63-.705-1.47-1.065-2.835-1.035l-.705.09c-.675.15-1.32.465-1.695.9-.975 1.05-.705 2.88.48 3.63 1.17.96 2.88 1.17 3.09 2.07.195 1.08-.81 1.425-1.83 1.305-.75-.18-1.17-.585-1.62-1.065l-1.83 1.05c.21.48.45.69.81 1.11 1.74 1.74 6.09 1.65 6.87-1.005.03-.09.24-.735.045-1.755z M11.97 11.34H9.63c0 1.44-.015 2.865-.015 4.305 0 .915.045 1.755-.1 2.015-.24.51-.87.45-1.155.36-.285-.15-.435-.375-.6-.66l-.015-.03-1.83 1.11c.3.63.735 1.17 1.32 1.515.855.51 2.004.675 3.21.39.78-.255 1.44-.765 1.74-1.515.435-.99.34-2.19.33-3.54.015-1.335 0-2.67 0-4.005z"/></svg>' },
  { label: 'TypeScript', svg: '<svg viewBox="0 0 24 24"><rect fill="#3178C6" width="24" height="24" rx="2"/><path fill="#fff" d="M5.88 15.06v1.56h2.76v7.38h1.86v-7.38h2.76v-1.5H5.88v-.06zm8.52-.12c.54.24.96.6 1.26.96.18.18.3.42.48.72l-1.62.96c-.06-.12-.18-.3-.3-.42-.36-.42-.72-.6-1.26-.6-.18 0-.36.06-.48.12-.12.06-.24.12-.3.24-.06.06-.12.18-.12.3-.06.12-.06.18-.06.3 0 .18.06.36.18.48.18.18.42.36.84.54l.66.3c.78.36 1.32.72 1.62 1.14.3.42.48.96.48 1.56 0 .48-.12.96-.36 1.32-.24.42-.6.72-1.08.96-.48.24-1.02.36-1.68.36-.96 0-1.74-.24-2.34-.78-.6-.48-.96-1.08-1.2-1.86l1.74-.72c.06.3.18.54.36.78.36.42.78.66 1.38.66.3 0 .54-.06.72-.18.24-.12.36-.36.36-.66 0-.24-.12-.48-.36-.72-.24-.18-.6-.42-1.14-.66l-.66-.3c-.6-.3-1.08-.6-1.38-1.02-.3-.42-.48-.9-.48-1.5s.12-.96.36-1.38c.24-.42.6-.72 1.02-.96.42-.24.96-.36 1.5-.36.78.06 1.44.24 1.92.6z"/></svg>' },
  { label: 'Angular', svg: '<svg viewBox="0 0 24 24"><path fill="#DD0031" d="M12 2.5L2.25 6.25l1.5 13L12 24.5l8.25-5.25 1.5-13L12 2.5zm0 2.17l6.75 12.08h-2.51l-1.37-3.4H9.11l-1.36 3.4H5.25L12 4.67zm0 4.25L9.87 13.5h4.26L12 8.92z"/></svg>' },
  { label: 'React', svg: '<svg viewBox="0 0 24 24"><circle fill="#61DAFB" cx="12" cy="11.87" r="2.15"/><path fill="none" stroke="#61DAFB" stroke-width="1" d="M12 7.07c4.05 0 7.57.93 9.35 2.3.57.44.96.92.96 1.5s-.39 1.06-.96 1.5c-1.78 1.37-5.3 2.3-9.35 2.3s-7.57-.93-9.35-2.3C2.08 11.93 1.69 11.45 1.69 10.87s.39-1.06.96-1.5C4.43 8 7.95 7.07 12 7.07z"/><path fill="none" stroke="#61DAFB" stroke-width="1" d="M8.53 9.47c2.03-3.5 4.58-6.04 6.62-6.94.66-.29 1.27-.37 1.78-.12s.8.79.96 1.5c.5 2.2-.26 5.5-2.29 9-.05.08-.1.16-.14.24-2.03 3.5-4.58 6.04-6.62 6.94-.66.29-1.27.37-1.78.12s-.8-.79-.96-1.5c-.5-2.2.26-5.5 2.29-9 .05-.08.1-.16.14-.24z"/><path fill="none" stroke="#61DAFB" stroke-width="1" d="M8.53 12.27c-2.03-3.5-2.79-6.8-2.29-9 .16-.71.45-1.25.96-1.5s1.12-.17 1.78.12c2.04.9 4.59 3.44 6.62 6.94.05.08.09.16.14.24 2.03 3.5 2.79 6.8 2.29 9-.16.71-.45 1.25-.96 1.5s-1.12.17-1.78-.12c-2.04-.9-4.59-3.44-6.62-6.94-.05-.08-.09-.16-.14-.24z"/></svg>' },
  { label: 'Flutter', svg: '<svg viewBox="0 0 24 24"><path fill="#02569B" d="M14.31 0L3 11.31l3.49 3.49L21.11 0H14.31zM14.31 11.68L8.1 17.89l3.49 3.49 2.72-2.72L21.11 11.68H14.31z"/></svg>' },
  { label: 'Raspberry Pi', svg: '<svg viewBox="0 0 24 24"><circle fill="#C51A4A" cx="12" cy="12" r="10"/><text x="12" y="16" text-anchor="middle" font-size="10" fill="white" font-weight="bold">π</text></svg>' },
  { label: 'ESP32', svg: '<svg viewBox="0 0 24 24"><rect fill="#E7352C" width="24" height="24" rx="4"/><text x="12" y="15" text-anchor="middle" font-size="7" fill="white" font-weight="bold">ESP</text></svg>' },
