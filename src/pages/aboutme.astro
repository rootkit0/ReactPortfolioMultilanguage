const serverIcons = [
  'TrueNAS', 'Docker', 'Kubernetes', 'AdGuard', 'Apache',
  'Nextcloud', 'Plex', 'Home Assistant', 'ESPHome', 'Mosquitto',
  'Cloudflare', 'Ngrok', 'MySQL', 'PostgreSQL', 'Monero',
];

const toolIcons = [
  'Android', 'iOS', 'macOS', 'Arch Linux', 'Windows', 'Creality',
  'VS Code', 'Sublime Text', 'IntelliJ', 'Eclipse',
  'Git', 'GitHub', 'Postman', 'Auth0', "Let's Encrypt",
  'npm', 'Node.js', 'WordPress', 'Elementor', 'Stripe',
];

const hobbies = [
  t(lang, 'about.read'), t(lang, 'about.travel'), t(lang, 'about.nature'),
  t(lang, 'about.gym'), t(lang, 'about.drive'), t(lang, 'about.cinema'),
];
---
<BaseLayout lang={lang} title={title} description={description}>

  <!-- ABOUT CARD -->
  <section class="section-block section-aboutme-more">
    <div class="container section-inner">
      <h1 class="section-title gradient-heading">{t(lang, 'about.more')}</h1>
      <div class="aboutme-card">
        <div class="about-chunks">
          <div class="about-chunk chunk-a"><p class="about-text">{t(lang, 'about.content1')}</p></div>
          <div class="about-chunk chunk-b"><p class="about-text">{t(lang, 'about.content2')}</p></div>
          <div class="about-chunk chunk-c"><p class="about-text">{t(lang, 'about.content3')}</p></div>
          <div class="about-chunk chunk-d"><p class="about-text">{t(lang, 'about.content4')}</p></div>
          <div><p class="about-text">{t(lang, 'about.content5')}</p></div>
        </div>
        <ul class="about-hobbies">
          {hobbies.map(h => (
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M14 1a1 1 0 011 1v12a1 1 0 01-1 1H2a1 1 0 01-1-1V2a1 1 0 011-1h12zM2 0a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V2a2 2 0 00-2-2H2z"/><path d="M10.97 4.97a.75.75 0 011.07 1.05l-3.99 4.99a.75.75 0 01-1.08.02L4.324 8.384a.75.75 0 111.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 01.02-.022z"/></svg>
              {h}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- SKILLSET -->
  <section class="section-block section-aboutme-skillset">
    <div class="container section-inner">
      <h2 class="section-title gradient-heading">{t(lang, 'about.skillset')}</h2>
      <div class="row stack-grid">
        {techIcons.map(icon => (
          <div class="col-4 col-md-2 tech-icons" title={icon.label}>
            <Fragment set:html={icon.svg} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVER APPS -->
  <section class="section-block section-aboutme-server">
    <div class="container section-inner">
      <h2 class="section-title gradient-heading">{t(lang, 'about.serverapps')}</h2>
      <div class="row stack-grid">
        {serverIcons.map(name => (
          <div class="col-4 col-md-2 tech-icons" title={name}>
            <span class="icon-label">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="section-block section-aboutme-tools">
    <div class="container section-inner">
      <h2 class="section-title gradient-heading">{t(lang, 'about.tools')}</h2>
      <div class="row stack-grid">
        {toolIcons.map(name => (
          <div class="col-4 col-md-2 tech-icons" title={name}>
            <span class="icon-label">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GITHUB -->
  <section class="section-block section-aboutme-code">
    <div class="container section-inner">
      <h2 class="section-title gradient-heading">{t(lang, 'about.code')}</h2>
      <div class="github-wrap">
        <div class="github-scroll">
          <img
            src="https://ghchart.rshah.org/0ea5e9/rootkit0"
            alt="GitHub contribution chart for rootkit0"
            width="722"
            height="112"
            loading="lazy"
            style="max-width:100%;height:auto;"
          />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .icon-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
    text-align: center;
    display: block;
  }
  .tech-icons svg {
    width: 2.5em;
    height: 2.5em;
  }
</style>
