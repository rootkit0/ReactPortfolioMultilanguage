---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { resolveLang } from '@/i18n';
const lang = resolveLang(Astro.request);
Astro.response.status = 404;
---
<BaseLayout lang={lang} title="404 - Página no encontrada | Xavier Berga" description="La página que buscas no existe.">
  <section class="section-block section-hero" style="padding-top:160px;padding-bottom:120px;">
    <div class="container section-inner text-center">
      <h1 class="section-title gradient-heading" style="font-size:4rem;">404</h1>
      <p class="section-subtitle" style="font-size:1.2rem;margin-bottom:24px;">La página que buscas no existe o ha sido movida.</p>
      <a href="/" class="btn btn-primary cta-btn">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
