---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { resolveLang, t } from '@/i18n';

import homeImg from '@/assets/images/home-main.png';

const lang = resolveLang(Astro.request);
const title = `${t(lang, 'home.im')} Xavier Berga | ${t(lang, 'home.services.ai.title')} & IoT`;
const description = t(lang, 'home.tagline');
const typewriterStrings: string[] = t(lang, 'typewriter');

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.xavierberga.com/#website",
      "url": "https://www.xavierberga.com/",
      "name": "Xavier Berga",
      "inLanguage": lang === 'ca' ? 'ca' : lang === 'en' ? 'en' : 'es-ES',
      "publisher": { "@id": "https://www.xavierberga.com/#person" }
    },
    {
      "@type": "WebPage",
      "@id": "https://www.xavierberga.com/#webpage",
      "url": "https://www.xavierberga.com/",
      "name": "Xavier Berga",
      "isPartOf": { "@id": "https://www.xavierberga.com/#website" },
      "inLanguage": lang === 'ca' ? 'ca' : lang === 'en' ? 'en' : 'es-ES'
    },
    {
      "@type": "Person",
      "@id": "https://www.xavierberga.com/#person",
      "name": "Xavier Berga",
      "url": "https://www.xavierberga.com/",
      "image": "https://www.xavierberga.com/og-image.png",
      "jobTitle": lang === 'en' ? "AI & IoT Engineer" : "Ingeniero en IoT e Inteligencia Artificial",
      "telephone": "+34644369266",
      "sameAs": [
        "https://www.linkedin.com/in/xavierberga",
        "https://github.com/rootkit0",
        "https://twitter.com/SecuredMargin"
      ],
      "knowsAbout": [
        "Inteligencia Artificial","Machine Learning","LLM","Visión Artificial",
        "Automatización","IoT","Firmware","Sensores","MQTT","Edge Computing","Ciberseguridad IoT"
      ]
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://www.xavierberga.com/#service",
      "name": "Servicios de IA e IoT - Xavier Berga",
      "url": "https://www.xavierberga.com/",
      "image": "https://www.xavierberga.com/og-image.png",
      "description": "Ingeniería y consultoría en Inteligencia Artificial e IoT: diseño, desarrollo, despliegue, integración y seguridad.",
      "telephone": "+34644369266",
      "provider": { "@id": "https://www.xavierberga.com/#person" },
      "areaServed": [
        { "@type": "City", "name": "Zaragoza" },
        { "@type": "City", "name": "Barcelona" },
        { "@type": "City", "name": "Lleida" },
        { "@type": "City", "name": "Madrid" }
      ],
      "contactPoint": [{
        "@type": "ContactPoint",
        "telephone": "+34644369266",
        "contactType": "sales",
        "areaServed": "ES",
        "availableLanguage": ["es","ca","en"]
      }],
      "serviceType": [
        "Consultoría en Inteligencia Artificial",
        "Desarrollo de IA (LLM, visión, automatización)",
        "IoT (firmware, sensores, MQTT, edge)",
        "Integración de plataformas y datos",
        "Ciberseguridad IoT"
      ]
    }
  ]
};

const iconAI = `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`;
const iconIoT = `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>`;

const cities = ['zaragoza', 'barcelona', 'lleida', 'madrid'];
---
<BaseLayout lang={lang} title={title} description={description} jsonLd={jsonLd}>

  <!-- HERO -->
  <section class="section-block section-hero home-section" id="home">
    <div class="container home-content">
      <div class="row align-items-center g-4">
        <div class="col-md-7 home-header text-center text-md-start">
          <p class="heading">
            {t(lang, 'home.salute')}{' '}
            <span class="wave" role="img" aria-label="wave">👋🏻</span>
          </p>
          <h1 class="heading-name">
            {t(lang, 'home.im')} <strong class="main-name">XAVIER BERGA</strong>
          </h1>
          <div class="type-wrap" id="typewriter-target" data-strings={JSON.stringify(typewriterStrings)}></div>
          <p class="hero-tagline mx-md-0 mx-auto">{t(lang, 'home.tagline')}</p>
          <div class="hero-cta justify-content-center justify-content-md-start">
            <a href="/projects" class="btn btn-primary cta-btn">{t(lang, 'navbar.projects')}</a>
            <a href="/resume" class="btn btn-outline-primary cta-btn">{t(lang, 'navbar.resume')}</a>
          </div>
        </div>
        <div class="col-md-5 d-flex justify-content-center">
          <div style="width:100%;max-width:520px">
            <img src={homeImg.src} alt={`Xavier Berga - ${t(lang, 'home.services.ai.title')} & IoT`} class="img-fluid hero-image" width="520" height="520" loading="eager" fetchpriority="high" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section-block section-about" id="about">
    <div class="container section-inner">
      <h2 class="section-title">{t(lang, 'home2.intro1')}</h2>
      <div class="about-chunks">
        <div class="about-chunk chunk-a"><p class="about-text">{t(lang, 'home2.intro2')}</p></div>
        <div class="about-chunk chunk-b"><p class="about-text">{t(lang, 'home2.intro3')}</p></div>
        <div class="about-chunk chunk-c"><p class="about-text">{t(lang, 'home2.intro4')}</p></div>
        <div class="about-chunk chunk-d"><p class="about-text">{t(lang, 'home2.intro5')}</p></div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section-block section-services" id="services">
    <div class="container section-inner">
      <h2 class="section-title">{t(lang, 'home.services.title')}</h2>
      <p class="section-subtitle">{t(lang, 'home.services.subtitle')}</p>
      <div class="row g-4 justify-content-center">
        <div class="col-md-6 col-lg-5">
          <ServiceCard
            icon={iconAI}
            title={t(lang, 'home.services.ai.title')}
            description={t(lang, 'home.services.ai.desc')}
            links={cities.map(c => ({ href: `/ia-${c}`, label: t(lang, `cities.${c}`) }))}
          />
        </div>
        <div class="col-md-6 col-lg-5">
          <ServiceCard
            icon={iconIoT}
            title={t(lang, 'home.services.iot.title')}
            description={t(lang, 'home.services.iot.desc')}
            links={cities.map(c => ({ href: `/iot-${c}`, label: t(lang, `cities.${c}`) }))}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FIND ME -->
  <section class="section-block section-findme" id="findme">
    <div class="container section-inner text-center">
      <h2 class="section-title">{t(lang, 'home2.findmeon')}</h2>
      <p class="section-subtitle">{t(lang, 'home2.connectme')}</p>
      <ul class="social-pills">
        <li><a href="https://wa.me/+34644369266" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a></li>
        <li><a href="https://www.linkedin.com/in/xavierberga/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 448 512"><path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 01107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.83-48.3 93.97 0 111.28 61.9 111.28 142.3V448z"/></svg>
        </a></li>
        <li><a href="https://github.com/rootkit0" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a></li>
      </ul>
    </div>
  </section>

</BaseLayout>

<script>
  // Simple typewriter effect (no framework needed)
  const el = document.getElementById('typewriter-target');
  if (el) {
    const strings: string[] = JSON.parse(el.dataset.strings || '[]');
    let si = 0, ci = 0, deleting = false;
    const speed = { type: 80, delete: 50, pause: 1800 };

    function tick() {
      const current = strings[si];
      if (!current) return;

      if (!deleting) {
        ci++;
        el.innerHTML = `<span class="Typewriter__wrapper">${current.slice(0, ci)}</span><span class="Typewriter__cursor">|</span>`;
        if (ci >= current.length) {
          deleting = true;
          setTimeout(tick, speed.pause);
          return;
        }
        setTimeout(tick, speed.type);
      } else {
        ci--;
        el.innerHTML = `<span class="Typewriter__wrapper">${current.slice(0, ci)}</span><span class="Typewriter__cursor">|</span>`;
        if (ci <= 0) {
          deleting = false;
          si = (si + 1) % strings.length;
          setTimeout(tick, speed.type * 4);
          return;
        }
        setTimeout(tick, speed.delete);
      }
    }
    tick();
  }
</script>
