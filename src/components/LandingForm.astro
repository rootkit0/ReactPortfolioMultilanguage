---
/**
 * Contact form for landing pages.
 * This is a static Astro component – the interactivity (WhatsApp/Email) is via a
 * small inline <script> so we avoid shipping any framework JS.
 */
interface Props {
  phone: string;
  email: string;
  serviceLabel: string;
  city: string;
  slug: string;
  emailSubject: string;
  labels: {
    formTitle: string;
    formLead: string;
    name: string;
    company: string;
    emailLabel: string;
    message: string;
    namePh: string;
    companyPh: string;
    emailPh: string;
    messagePh: string;
    sendWhatsApp: string;
    sendEmail: string;
    service: string;
    source: string;
  };
}

const { phone, email, serviceLabel, city, slug, emailSubject, labels } = Astro.props;
const formId = `form-${slug}`;
---
<div class="mini-form" id={formId}>
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">{labels.name}</label>
      <input type="text" class="form-control" data-field="name" placeholder={labels.namePh} />
    </div>
    <div class="col-md-6">
      <label class="form-label">{labels.company}</label>
      <input type="text" class="form-control" data-field="company" placeholder={labels.companyPh} />
    </div>
    <div class="col-md-12">
      <label class="form-label">{labels.emailLabel}</label>
      <input type="email" class="form-control" data-field="email" placeholder={labels.emailPh} />
    </div>
    <div class="col-md-12">
      <label class="form-label">{labels.message}</label>
      <textarea class="form-control" rows="4" data-field="message" placeholder={labels.messagePh}></textarea>
    </div>
    <div class="col-md-12 mini-form-actions">
      <button type="button" class="btn btn-primary cta-btn" data-action="whatsapp">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        &nbsp; {labels.sendWhatsApp}
      </button>
      <button type="button" class="btn btn-outline-primary cta-btn" data-action="email">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        &nbsp; {labels.sendEmail}
      </button>
    </div>
  </div>
</div>

<script define:vars={{ formId, phone, email, serviceLabel, city, slug, emailSubject, serviceKey: labels.service, nameKey: labels.name, companyKey: labels.company, emailKey: labels.emailLabel, messageKey: labels.message, sourceKey: labels.source }}>
  const form = document.getElementById(formId);
  if (form) {
    const get = (f) => (form.querySelector(`[data-field="${f}"]`)?.value || '-');
    const buildBody = () => {
      return [
        `${serviceKey}: ${serviceLabel} (${city})`,
        `${nameKey}: ${get('name')}`,
        `${companyKey}: ${get('company')}`,
        `${emailKey}: ${get('email')}`,
        '',
        `${messageKey}:`,
        get('message'),
        '',
        `${sourceKey}: /${slug}`,
      ].join('\n');
    };

    form.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      const body = buildBody();
      if (btn.dataset.action === 'whatsapp') {
        window.open(`https://wa.me/${phone}?text=${encodeURIComponent(body)}`, '_blank', 'noopener,noreferrer');
      } else {
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(body)}`;
      }
    });
  }
</script>
