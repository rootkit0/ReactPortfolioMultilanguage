---
import type { Lang } from '@/i18n';
import { localePath } from '@/i18n';
import { contact } from '@/data/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();

const labels = {
  es: {
    tagline: 'Ingenieria de IA e IoT con enfoque en sistemas utiles, claros y mantenibles.',
    links: 'Enlaces',
    contact: 'Contacto',
    ai: 'IA',
    iot: 'IoT',
    projects: 'Proyectos',
    about: 'Sobre mi',
  },
  ca: {
    tagline: 'Enginyeria d IA i IoT amb enfocament en sistemes utils, clars i mantenibles.',
    links: 'Enllacos',
    contact: 'Contacte',
    ai: 'IA',
    iot: 'IoT',
    projects: 'Projectes',
    about: 'Sobre mi',
  },
  en: {
    tagline: 'AI and IoT engineering focused on useful, clear, and maintainable systems.',
    links: 'Links',
    contact: 'Contact',
    ai: 'AI',
    iot: 'IoT',
    projects: 'Projects',
    about: 'About',
  },
}[lang];
---
<footer class="footer">
  <div class="footer-inner footer-grid">
    <div class="footer-col footer-brand">
      <p class="footer-title">Xavier Berga</p>
      <p>{labels.tagline}</p>
      <p>Copyleft {year}</p>
    </div>

    <div class="footer-col">
      <p class="footer-title">{labels.links}</p>
      <ul class="footer-links">
        <li><a href={localePath(lang, '/inteligencia-artificial')}>{labels.ai}</a></li>
        <li><a href={localePath(lang, '/iot')}>{labels.iot}</a></li>
        <li><a href={localePath(lang, '/projects')}>{labels.projects}</a></li>
        <li><a href={localePath(lang, '/aboutme')}>{labels.about}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-title">{labels.contact}</p>
      <ul class="footer-links">
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={`https://wa.me/${contact.phone}`} target="_blank" rel="noopener noreferrer">{contact.phoneDisplay}</a></li>
        <li><a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      </ul>
    </div>
  </div>
</footer>
