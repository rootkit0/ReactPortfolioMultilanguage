---
import type { Lang } from '@/i18n';
import { t } from '@/i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;

import logo from '@/assets/logos/logo.png';
import esFlag from '@/assets/flags/es.svg';
import caFlag from '@/assets/flags/cat.svg';
import enFlag from '@/assets/flags/en.svg';
---
<nav class="navbar" id="main-nav">
  <div class="container">
    <a href="/" class="navbar-brand d-flex" aria-label="Xavier Berga - Home">
      <img src={logo.src} class="img-fluid logo" alt="Xavier Berga" width="34" height="34" loading="eager" />
    </a>

    <button class="navbar-toggler collapsed" type="button" aria-controls="responsive-navbar-nav" aria-expanded="false" aria-label="Toggle navigation" id="nav-toggler">
      <span></span><span></span><span></span>
    </button>

    <div class="navbar-collapse" id="responsive-navbar-nav">
      <ul class="nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">{t(lang, 'navbar.home')}</a></li>
        <li class="nav-item"><a class="nav-link" href="/aboutme">{t(lang, 'navbar.about')}</a></li>
        <li class="nav-item"><a class="nav-link" href="/projects">{t(lang, 'navbar.projects')}</a></li>
        <li class="nav-item"><a class="nav-link" href="/resume">{t(lang, 'navbar.resume')}</a></li>
        <li class="nav-item px-2 d-flex justify-content-center align-items-center">
          <div class="lang-selector" aria-label="Language selector">
            <img src={esFlag.src} alt="Español" data-lang="es" class={`lang-flag ${lang === 'es' ? 'active' : ''}`} width="30" height="20" />
            <img src={caFlag.src} alt="Català" data-lang="ca" class={`lang-flag ${lang === 'ca' ? 'active' : ''}`} width="30" height="20" />
            <img src={enFlag.src} alt="English" data-lang="en" class={`lang-flag ${lang === 'en' ? 'active' : ''}`} width="30" height="20" />
          </div>
        </li>
        <li class="nav-item d-flex align-items-center">
          <a href="https://github.com/rootkit0" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            &nbsp; GitHub
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  // Sticky navbar on scroll
  const nav = document.getElementById('main-nav');
  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle('sticky', window.scrollY >= 20);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile toggle
  const toggler = document.getElementById('nav-toggler');
  const collapse = document.getElementById('responsive-navbar-nav');
  toggler?.addEventListener('click', () => {
    const expanded = toggler.getAttribute('aria-expanded') === 'true';
    toggler.setAttribute('aria-expanded', String(!expanded));
    toggler.classList.toggle('collapsed', expanded);
    collapse?.classList.toggle('show', !expanded);
  });

  // Close on link click
  collapse?.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      toggler?.classList.add('collapsed');
      toggler?.setAttribute('aria-expanded', 'false');
      collapse?.classList.remove('show');
    });
  });
</script>
