---
import type { Lang } from '@/i18n';
import { localePath, stripLangFromPath } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

import logo from '@/assets/logos/logo.png';
import esFlag from '@/assets/flags/es.svg';
import caFlag from '@/assets/flags/cat.svg';
import enFlag from '@/assets/flags/en.svg';

const currentPath = stripLangFromPath(Astro.url.pathname);
const navLabels: Record<Lang, { home: string; ai: string; iot: string; projects: string; about: string; resume: string }> = {
  es: { home: 'Inicio', ai: 'IA', iot: 'IoT', projects: 'Proyectos', about: 'Sobre mi', resume: 'CV' },
  ca: { home: 'Inici', ai: 'IA', iot: 'IoT', projects: 'Projectes', about: 'Sobre mi', resume: 'CV' },
  en: { home: 'Home', ai: 'AI', iot: 'IoT', projects: 'Projects', about: 'About', resume: 'Resume' },
};
---
<nav class="navbar" id="main-nav">
  <div class="container">
    <a href={localePath(lang, '/')} class="navbar-brand d-flex" aria-label="Xavier Berga home">
      <img src={logo.src} class="img-fluid logo" alt="Xavier Berga" width="34" height="34" loading="eager" />
    </a>

    <button class="navbar-toggler collapsed" type="button" aria-controls="responsive-navbar-nav" aria-expanded="false" aria-label="Toggle navigation" id="nav-toggler">
      <span></span><span></span><span></span>
    </button>

    <div class="navbar-collapse" id="responsive-navbar-nav">
      <ul class="nav ms-auto">
        <li class="nav-item"><a class="nav-link" href={localePath(lang, '/')}>{navLabels[lang].home}</a></li>
        <li class="nav-item"><a class="nav-link" href={localePath(lang, '/inteligencia-artificial')}>{navLabels[lang].ai}</a></li>
        <li class="nav-item"><a class="nav-link" href={localePath(lang, '/iot')}>{navLabels[lang].iot}</a></li>
        <li class="nav-item"><a class="nav-link" href={localePath(lang, '/projects')}>{navLabels[lang].projects}</a></li>
        <li class="nav-item"><a class="nav-link" href={localePath(lang, '/aboutme')}>{navLabels[lang].about}</a></li>
        <li class="nav-item"><a class="nav-link" href={localePath(lang, '/resume')}>{navLabels[lang].resume}</a></li>
        <li class="nav-item px-2 d-flex justify-content-center align-items-center">
          <div class="lang-selector" aria-label="Language selector">
            <a href={localePath('es', currentPath)} aria-label="Español"><img src={esFlag.src} alt="Español" class={`lang-flag ${lang === 'es' ? 'active' : ''}`} width="30" height="20" /></a>
            <a href={localePath('ca', currentPath)} aria-label="Català"><img src={caFlag.src} alt="Català" class={`lang-flag ${lang === 'ca' ? 'active' : ''}`} width="30" height="20" /></a>
            <a href={localePath('en', currentPath)} aria-label="English"><img src={enFlag.src} alt="English" class={`lang-flag ${lang === 'en' ? 'active' : ''}`} width="30" height="20" /></a>
          </div>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('main-nav');
  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle('sticky', window.scrollY >= 20);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const toggler = document.getElementById('nav-toggler');
  const collapse = document.getElementById('responsive-navbar-nav');
  toggler?.addEventListener('click', () => {
    const expanded = toggler.getAttribute('aria-expanded') === 'true';
    toggler.setAttribute('aria-expanded', String(!expanded));
    toggler.classList.toggle('collapsed', expanded);
    collapse?.classList.toggle('show', !expanded);
  });

  collapse?.querySelectorAll('.nav-link, .lang-selector a').forEach((link) => {
    link.addEventListener('click', () => {
      toggler?.classList.add('collapsed');
      toggler?.setAttribute('aria-expanded', 'false');
      collapse?.classList.remove('show');
    });
  });
</script>
