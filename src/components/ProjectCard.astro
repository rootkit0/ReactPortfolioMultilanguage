---
interface Props {
  imgSrc: string;
  imgAlt: string;
  title: string;
  description: string;
  srcLink?: string;
  demoLink?: string;
  visitText: string;
  openSource?: boolean;
  sourceText?: string;
}
const { imgSrc, imgAlt, title, description, srcLink, demoLink, visitText, openSource, sourceText = 'GitHub' } = Astro.props;
const hasGithub = openSource && srcLink;
---
<article class="project-card-view">
  <div class="project-media">
    <img src={imgSrc} alt={imgAlt} class="project-media-img" width="400" height="170" loading="lazy" />
  </div>
  <div class="project-body">
    <div class="project-text">
      <h3 class="project-title">{title}</h3>
      <p class="project-desc">{description}</p>
    </div>
    {(hasGithub || demoLink) && (
      <div class="project-actions">
        {hasGithub && (
          <a href={srcLink} target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary project-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            &nbsp; {sourceText}
          </a>
        )}
        {demoLink && (
          <a href={demoLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary project-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M11.996 2a10 10 0 100 20 10 10 0 000-20zm6.932 6h-2.95a15.65 15.65 0 00-1.38-3.56A8.03 8.03 0 0118.928 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96H10.09c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14a7.822 7.822 0 010-4h3.38a16.3 16.3 0 000 4H4.26zm.67 2h2.95a15.65 15.65 0 001.38 3.56A8.03 8.03 0 014.93 16zm2.95-8H4.93a8.03 8.03 0 014.38-3.56A15.65 15.65 0 007.88 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66a14.81 14.81 0 010-4h4.68a14.81 14.81 0 010 4zm.25 5.56A15.65 15.65 0 0015.97 16h2.95a8.03 8.03 0 01-4.33 3.56zM16.36 14a16.3 16.3 0 000-4h3.38a7.822 7.822 0 010 4h-3.38z"/></svg>
            &nbsp; {visitText}
          </a>
        )}
      </div>
    )}
  </div>
</article>
